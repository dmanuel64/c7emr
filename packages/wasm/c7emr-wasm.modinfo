<?xml version="1.0" encoding="utf-8"?>
<Mod id="ytm-c7emr-wasm" version="1"
    xmlns="ModInfo">
    <Properties>
        <Name>C7EMR - WASM</Name>
        <Description>Lets Civ7 mod creators write mods in
            WebAssembly-compiled languages instead of JavaScript. Adds no content by itself - other
            mods will list this as a requirement if they need it.</Description>
        <Authors>youngtacomanny</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
    </Dependencies>
    <References>
    </References>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="c7emr-wasm-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>0</LoadOrder>
            </Properties>
            <Actions>
                <UIScripts>
                    <Item>ui/c7emr-wasm.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="c7emr-wasm-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>0</LoadOrder>
            </Properties>
            <Actions>
                <UIScripts>
                    <Item>ui/c7emr-wasm.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>