<?xml version="1.0" encoding="utf-8"?>
<Mod id="ytm-c7emr-python" version="1"
    xmlns="ModInfo">
    <Properties>
        <Name>C7EMR - Python</Name>
        <Description>Lets Civ7 mod creators write mods in Python instead of JavaScript. Adds no
            content by itself - other mods will list this as a requirement if they need it.</Description>
        <Authors>youngtacomanny</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
    </Dependencies>
    <References>
    </References>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet />
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="c7emr-python-shell" scope="shell" criteria="always">
            <Actions>
                <UIScripts>
                    <Item>ui/c7emr-python.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="c7emr-python-game" scope="game" criteria="always">
            <Actions>
                <UIScripts>
                    <Item>ui/c7emr-python.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>